---
import Icon from "./Icon.astro";
import type { Post } from "~/lib/posts";
import { entryPath, entrySlug } from "~/lib/posts";
import { formatDate, t } from "~/lib/i18n";
import type { Locale } from "~/config";

interface Props {
  post: Post;
  locale: Locale;
  dense?: boolean;
}

const { post, locale, dense = false } = Astro.props;
const href = entryPath(post);
const slug = entrySlug(post);
const categories = (post.data.categories as string[]) ?? [];
const tags = (post.data.tags as string[]) ?? [];
const readingTime = (post.data as any).readingTime as number | undefined;
---
<article class={`post-card bg-[var(--color-card)] text-[var(--color-card-foreground)] border border-[var(--color-border)] rounded-xl ${dense ? "p-4 sm:p-5" : "p-5 sm:p-6"}`}>
  <a href={href} class="block no-underline">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--color-muted-foreground)] mb-2">
      <span class="inline-flex items-center gap-1"><Icon name="calendar" size={14} />{formatDate(post.data.date, locale)}</span>
      {readingTime && <span class="inline-flex items-center gap-1"><Icon name="clock" size={14} />{readingTime} {t("post.readingTime", locale)}</span>}
      <span class="inline-flex items-center gap-1" data-like-count-display data-slug={slug}>
        <Icon name="heart" size={14} />
        <span class="tabular-nums">—</span>
      </span>
      {categories.map((c) => (
        <span class="inline-flex items-center gap-1 text-[var(--color-primary)]">
          <Icon name="folder" size={14} />{c}
        </span>
      ))}
    </div>
    <h2 class={`${dense ? "text-lg" : "text-xl sm:text-[1.35rem]"} font-semibold tracking-tight text-[var(--color-foreground)] leading-snug hover:text-[var(--color-primary)] transition-colors`}>
      {post.data.title}
    </h2>
    {post.data.description && (
      <p class="mt-2 text-sm text-[var(--color-muted-foreground)] line-clamp-2 leading-relaxed">
        {post.data.description}
      </p>
    )}
    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((tag) => (
          <span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full bg-[var(--color-muted)] text-[var(--color-muted-foreground)]">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </a>
</article>
