---
import Icon from "./Icon.astro";
import { type Locale } from "~/config";
import { t } from "~/lib/i18n";

interface Props { slug: string; locale: Locale; }
const { slug, locale } = Astro.props;
---
<div data-like-widget data-slug={slug} class="mt-10 border-t border-[var(--color-border)] pt-8 flex flex-col items-center gap-3">
  <button
    type="button"
    data-like-btn
    class="group inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-card)] px-5 py-2.5 text-sm font-medium text-[var(--color-foreground)] hover:border-[color-mix(in_srgb,var(--color-primary)_40%,var(--color-border))] hover:shadow-md transition-all"
    aria-label={t("likes.label", locale)}
  >
    <span class="inline-flex transition-transform group-hover:scale-110" data-like-icon>
      <Icon name="heart" size={18} />
    </span>
    <span data-like-count class="tabular-nums">—</span>
  </button>
</div>

<script define:vars={{ slug }}>
  (function () {
    const root = document.querySelector(
      '[data-like-widget][data-slug="' + CSS.escape(slug) + '"]'
    );
    if (!root) return;
    const btn = root.querySelector('[data-like-btn]');
    const countEl = root.querySelector('[data-like-count]');
    const iconEl = root.querySelector('[data-like-icon]');

    const heartOutline =
      '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/></svg>';
    const heartFill =
      '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/></svg>';

    let state = { count: 0, liked: false };

    function render() {
      countEl.textContent = String(state.count);
      iconEl.innerHTML = state.liked ? heartFill : heartOutline;
      btn.classList.toggle('text-[var(--color-primary)]', state.liked);
      btn.classList.toggle('border-[color-mix(in_srgb,var(--color-primary)_40%,var(--color-border))]', state.liked);
      btn.setAttribute('aria-pressed', String(state.liked));
    }

    async function refresh() {
      try {
        const r = await fetch('/api/likes/' + encodeURIComponent(slug), {
          credentials: 'include',
        });
        if (!r.ok) throw new Error('bad status');
        const j = await r.json();
        state.count = j.count ?? 0;
        state.liked = !!j.liked;
      } catch {
        state.count = 0;
        state.liked = false;
      }
      render();
    }

    async function toggle() {
      const prev = { ...state };
      state.liked = !state.liked;
      state.count += state.liked ? 1 : -1;
      if (state.count < 0) state.count = 0;
      render();
      try {
        const r = await fetch('/api/likes/' + encodeURIComponent(slug), {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: state.liked ? 'like' : 'unlike' }),
        });
        if (!r.ok) throw new Error('bad');
        const j = await r.json();
        state.count = j.count ?? state.count;
        state.liked = !!j.liked;
        render();
        // Broadcast so PostCards / meta badges on the same page stay in sync.
        document.dispatchEvent(new CustomEvent('like-updated', {
          detail: { slug, count: state.count },
        }));
      } catch {
        state = prev;
        render();
      }
    }

    btn.addEventListener('click', toggle);
    refresh();
  })();
</script>
