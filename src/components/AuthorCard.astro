---
import Icon from "./Icon.astro";
import { SITE, type Locale } from "~/config";
import { t } from "~/lib/i18n";

interface Props { locale?: Locale; }
const { locale = SITE.defaultLocale } = Astro.props;
const a = SITE.author;
const hiddenTip = t("social.hidden", locale);
---
<section class="mb-12">
  <div class="bg-[var(--color-card)] text-[var(--color-card-foreground)] border border-[var(--color-border)] rounded-2xl p-6 sm:p-8 shadow-sm">
    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
      <img src={a.avatar} alt={a.name[locale]} class="h-24 w-24 rounded-full object-cover shadow-md ring-4 ring-[color-mix(in_srgb,var(--color-primary)_20%,transparent)]" />
      <div class="min-w-0 flex-1">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-foreground)] mb-1.5">
          {a.name[locale]}
        </h1>
        <p class="text-[var(--color-muted-foreground)] text-base mb-3">{a.title[locale]}</p>
        <p class="text-[var(--color-foreground)] leading-relaxed mb-4">{a.description[locale]}</p>
        <div class="flex flex-wrap gap-2 justify-center md:justify-start">
          {a.social.map((s) => (
            <div class="social-btn-wrap relative group/social">
              <span
                class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-muted)] text-[var(--color-muted-foreground)] px-3 py-1.5 text-sm font-medium cursor-not-allowed select-none opacity-60"
                aria-disabled="true"
              >
                <Icon name={s.icon} size={16} />
                <span>{s.name}</span>
              </span>
              <span
                class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 whitespace-nowrap rounded-md bg-[var(--color-foreground)] text-[var(--color-background)] text-xs px-2.5 py-1 opacity-0 group-hover/social:opacity-100 transition-opacity duration-150"
              >
                {hiddenTip}
                <span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-[var(--color-foreground)]"></span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
