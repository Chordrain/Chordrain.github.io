---
import { SITE, type Locale } from "~/config";
import { t } from "~/lib/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-[var(--color-border)] py-10 text-sm text-[var(--color-muted-foreground)]">
  <div class="container-page flex flex-col sm:flex-row items-center justify-between gap-4">
    <p>
      © {year} {SITE.author.name[locale]}. {t("footer.poweredBy", locale)}.
      {" "}{t("footer.theme", locale)}{" "}
      <a
        href="https://github.com/tom2almighty/hugo-narrow"
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2 hover:text-[var(--color-foreground)] transition-colors"
      >Narrow</a>.
    </p>
    <div class="flex items-center gap-4">
      {SITE.author.social.map((s) => (
        <span class="opacity-40 cursor-not-allowed select-none">{s.name}</span>
      ))}
    </div>
  </div>
</footer>
