---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPublishedPosts, groupByYear, entryPath } from "~/lib/posts";
import { formatDate, t } from "~/lib/i18n";

const locale = "en" as const;
const posts = await getPublishedPosts(locale);
const groups = groupByYear(posts);
---
<BaseLayout title={t("archive.title", locale)} locale={locale}>
  <h1 class="text-3xl font-bold tracking-tight mb-8">{t("archive.title", locale)}</h1>
  <div class="space-y-10">
    {groups.map((g) => (
      <section>
        <h2 class="text-2xl font-semibold text-[var(--color-primary)] mb-4">{g.year}</h2>
        <ul class="space-y-2 border-l border-[var(--color-border)] pl-5">
          {g.posts.map((p) => (
            <li class="relative">
              <span class="absolute -left-[26px] top-2 w-2 h-2 rounded-full bg-[var(--color-border)]"></span>
              <a href={entryPath(p)} class="flex flex-col sm:flex-row sm:items-baseline sm:gap-4 py-1 text-[var(--color-foreground)] hover:text-[var(--color-primary)] transition-colors">
                <span class="text-xs text-[var(--color-muted-foreground)] shrink-0 tabular-nums">{formatDate(p.data.date, locale)}</span>
                <span class="font-medium">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
